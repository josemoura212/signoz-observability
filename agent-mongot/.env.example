# IP privado do servidor onde roda o SigNoz
SIGNOZ_ENDPOINT=10.0.0.173

# Nome do host no SigNoz (host.name)
HOST_NAME=unni-mongot

# mongot expoe metricas Prometheus na 9946 (publicada em 0.0.0.0)
MONGOT_ENDPOINT=localhost:9946

# ClickHouse roda na bridge default sem publicar a 9363.
# Usar o IP do container (docker inspect clickhouse-server).
CLICKHOUSE_ENDPOINT=172.17.0.4:9363
