# IP do servidor onde roda o SigNoz
SIGNOZ_ENDPOINT=10.0.0.X

OTELCOL_CONTRIB_VERSION=0.146.0

# Kafka broker(s) - separar multiplos com virgula
KAFKA_BROKERS=localhost:9092

# (otel-agent usa hostname '{{.Node.Hostname}}' no Swarm -> nao precisa HOST_NAME)

# --- JMX scrapers (no docker-compose.yml, deploy via Swarm) ---
# 3 services replicas:1 (1 por broker) -> throughput real + saude broker/JVM.
# IPs JMX (9999) hardcoded no docker-compose.yml: 10.0.0.83 / 10.0.0.221 / 10.0.0.166.
# Pre-requisito: JMX 9999 acessivel nos brokers (ja exposto). Validar com jmxterm antes.
